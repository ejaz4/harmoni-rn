{
  "expo": {
    "name": "Harmoni",
    "slug": "harmoni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.ceccun.harmoni",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "bundleIdentifier": "com.ceccun.harmoni",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ceccun.harmoni",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true,
            "networkInspector": false
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
            "node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
            "node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/outfit/700Bold/Outfit_700Bold.ttf",
            "node_modules/@expo-google-fonts/outfit/800ExtraBold/Outfit_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/fraunces/700Bold/Fraunces_700Bold.ttf",
            "node_modules/@expo-google-fonts/playfair-display/700Bold/PlayfairDisplay_700Bold.ttf",
            "node_modules/@expo-google-fonts/space-grotesk/700Bold/SpaceGrotesk_700Bold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/jetbrains-mono/700Bold/JetBrainsMono_700Bold.ttf",
            "node_modules/@expo-google-fonts/bebas-neue/400Regular/BebasNeue_400Regular.ttf",
            "node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf",
            "node_modules/@expo-google-fonts/silkscreen/400Regular/Silkscreen_400Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
